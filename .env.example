# Copy to .env. Everything has a default; nothing here is required for the demo.

# Postgres connection. Inside docker compose the host is the `postgres` service.
DATABASE_URL=postgres://app:app@postgres:5432/app

# Port the API listens on.
PORT=3000

# Optional. Lifts the unauthenticated Socrata rate limit. Never committed.
SOCRATA_APP_TOKEN=

# How often the scheduler runs the ECB pipeline. Accepts 30m, 6h, 24h, 1d.
INGEST_INTERVAL=24h

# Timeout for a single Socrata request, in milliseconds.
SOCRATA_TIMEOUT_MS=15000

# ECB fetch: BINs per Socrata call (1,000 works, 1,200 is HTTP 414), rows per
# page, and the ceiling on pages for one batch.
BATCH_SIZE=600
# Lots per Building Footprints call during bulk import (two in-lists per query).
FOOTPRINTS_BATCH_SIZE=500
ECB_PAGE_SIZE=1000
MAX_PAGES_PER_BATCH=50

# Socrata politeness: attempts per call (429 / 5xx / timeout are retried with
# backoff, 4xx never) and the minimum gap between calls.
MAX_ATTEMPTS=4
MIN_MS_BETWEEN_CALLS=250

# Test knobs for the walkthrough, off by default: exit the process after batch
# n (to demonstrate resume) or make batch n fail (to demonstrate partial runs).
# INGEST_KILL_AFTER_BATCH=
# INGEST_FAIL_BATCH=

# GeoSearch (address → BBL): per-request timeout and how many attempts before giving up as pending.
GEOSEARCH_TIMEOUT_MS=10000
GEOSEARCH_ATTEMPTS=2
