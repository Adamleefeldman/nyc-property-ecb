# Copy to .env. Everything has a default; nothing here is required for the demo.

# Postgres connection. Inside docker compose the host is the `postgres` service.
DATABASE_URL=postgres://app:app@postgres:5432/app

# Port the API listens on.
PORT=3000

# Optional. Lifts the unauthenticated Socrata rate limit. Never committed.
SOCRATA_APP_TOKEN=

# How often the scheduler runs the ECB pipeline. Accepts 30m, 6h, 24h, 1d.
INGEST_INTERVAL=24h

# Timeout for a single Socrata request, in milliseconds.
SOCRATA_TIMEOUT_MS=15000
